{
    "project_name": "EcoMenu",
    "infrastructure": {
        "frontend": "React",
        "backend": "FastAPI",
        "database": "PostgreSQL sur Supabase"
    },
    "database_schema": [
        {
            "table_name": "users",
            "description": "Informations sur les utilisateurs et leurs préférences",
            "columns": [
                {
                    "name": "id",
                    "type": "UUID",
                    "primary_key": true,
                    "foreign_key_to": null
                },
                {
                    "name": "budget_max",
                    "type": "FLOAT",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "taille_foyer",
                    "type": "INTEGER",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "gestion_restes",
                    "type": "BOOLEAN",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "type_boite_lunch",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "profil_boite_lunch",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                }
            ]
        },
        {
            "table_name": "enseigne_selection",
            "description": "Enseignes sélectionnées par les utilisateurs",
            "columns": [
                {
                    "name": "id",
                    "type": "UUID",
                    "primary_key": true,
                    "foreign_key_to": null
                },
                {
                    "name": "user_id",
                    "type": "UUID",
                    "primary_key": false,
                    "foreign_key_to": "users"
                },
                {
                    "name": "enseigne",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                }
            ]
        },
        {
            "table_name": "promotions",
            "description": "Données promotionnelles extraites des circulaires",
            "columns": [
                {
                    "name": "id",
                    "type": "UUID",
                    "primary_key": true,
                    "foreign_key_to": null
                },
                {
                    "name": "enseigne",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "nom_produit",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "prix_promo",
                    "type": "FLOAT",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "poids_volume",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "unite_mesure",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "categorie_alimentaire",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                }
            ]
        },
        {
            "table_name": "produit_tags",
            "description": "Tags standardisés pour les produits",
            "columns": [
                {
                    "name": "id",
                    "type": "UUID",
                    "primary_key": true,
                    "foreign_key_to": null
                },
                {
                    "name": "nom_produit",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "tag_standard",
                    "type": "TEXT",
                    "primary_key": false,
                    "foreign_key_to": null
                }
            ]
        },
        {
            "table_name": "menus",
            "description": "Menus hebdomadaires générés pour les utilisateurs",
            "columns": [
                {
                    "name": "id",
                    "type": "UUID",
                    "primary_key": true,
                    "foreign_key_to": null
                },
                {
                    "name": "user_id",
                    "type": "UUID",
                    "primary_key": false,
                    "foreign_key_to": "users"
                },
                {
                    "name": "menu_data",
                    "type": "JSONB",
                    "primary_key": false,
                    "foreign_key_to": null
                },
                {
                    "name": "date_generation",
                    "type": "TIMESTAMP",
                    "primary_key": false,
                    "foreign_key_to": null
                }
            ]
        }
    ],
    "api_endpoints": [
        {
            "method": "POST",
            "path": "/api/v1/users",
            "description": "Créer un nouvel utilisateur",
            "payload": "{\"budget_max\": 100.0, \"taille_foyer\": 4, \"gestion_restes\": true, \"type_boite_lunch\": \"sandwichs\", \"profil_boite_lunch\": \"adultes\"}",
            "response": "{\"id\": \"UUID\"}"
        },
        {
            "method": "GET",
            "path": "/api/v1/promotions",
            "description": "Récupérer les promotions actuelles",
            "payload": null,
            "response": "[{\"id\": \"UUID\", \"enseigne\": \"Metro\", \"nom_produit\": \"Poulet entier\", \"prix_promo\": 1.99, \"poids_volume\": \"1 lb\", \"unite_mesure\": \"lb\", \"categorie_alimentaire\": \"Viande\"}]"
        },
        {
            "method": "POST",
            "path": "/api/v1/menus",
            "description": "Générer un menu hebdomadaire pour un utilisateur",
            "payload": "{\"user_id\": \"UUID\"}",
            "response": "{\"id\": \"UUID\", \"menu_data\": {\"lundi\": \"Poulet rôti aux herbes\", \"mardi\": \"Salade de tomates\"}}"
        }
    ]
}